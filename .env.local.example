# 이 파일을 복사해서 .env.local로 이름을 바꾸고, 실제 값을 채워 넣으세요.
# .env.local은 절대 GitHub에 올라가지 않습니다 (.gitignore에 이미 등록되어 있음).

# Supabase — Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud — Places API (New)용 API Key
GOOGLE_PLACES_API_KEY=

# 관리자 페이지(/admin) 로그인 비밀번호 — 직접 정하시면 됩니다
ADMIN_PASSWORD=

# 웹 검색 공급자 (lib/searchProvider.ts 참고) — 아직 미연결 시 비워두세요
SEARCH_PROVIDER=

# 과거 행사 데이터를 AI로 구조화할 때 사용 (Anthropic API Key)
ANTHROPIC_API_KEY=
